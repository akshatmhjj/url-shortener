{
  "buildCommand": "cd url-shortener-frontend && npm run build",
  "outputDirectory": "url-shortener-frontend/dist",
  "devCommand": "cd url-shortener-frontend && npm run dev",
  "installCommand": "cd url-shortener-frontend && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}