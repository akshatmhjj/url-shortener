# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=86400

# JWT Configuration
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRY=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=


# API Configuration
API_URL=http://localhost:3000
API_VERSION=v1
MAX_URL_LENGTH=2048
MIN_CUSTOM_ALIAS_LENGTH=3
MAX_CUSTOM_ALIAS_LENGTH=50

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_REQUESTS_PRO=1000

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=2555

# GeoIP Service (MaxMind or similar)
GEOIP_SERVICE=maxmind
GEOIP_API_KEY=YOUR_API_KEY_HERE

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging
LOG_FORMAT=json
