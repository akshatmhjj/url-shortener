# Copy this file to .env on the deployment machine. Do not commit .env.
# Generate passwords and JWT_SECRET with a password manager or a cryptographic generator.

# Public application URLs. Use the final HTTPS domain after Phase 10.
API_URL=http://localhost
CORS_ORIGIN=http://localhost

# PostgreSQL
POSTGRES_DB=url_shortener
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Redis (private Docker service, still protected with a password)
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Authentication
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID

# Vite exposes VITE_* values to browser code. Never put a secret in this value.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
